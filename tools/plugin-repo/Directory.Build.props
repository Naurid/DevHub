<!--
  Shared by every plugin in this repository. A plugin builds against DevHub's Sdk: the NuGet packages
  DevHub.Sdk + DevHub.Sdk.Core (nuget.org, published with each DevHub release). DevHub ships the Sdk,
  Avalonia, CommunityToolkit.Mvvm and DI itself, so they're build-only here (ExcludeAssets="runtime") and
  never copied into a plugin's package. Avalonia, CommunityToolkit.Mvvm and DI are referenced directly
  because their build parts (the XAML compiler, the [ObservableProperty] generators) don't come along
  through the Sdk package; keep their versions equal to DevHub's (a lower one fails the restore: NU1605).

  Which Sdk: DevHubSdkVersion, by default the newest release ("*"). To work against unreleased Sdk
  changes, pack them in DevHub (pwsh build/Pack-Sdk.ps1 → ../local-feed, next to both repositories)
  and build with the version it prints:
    dotnet build plugins/HelloWorld -p:DevHubSdkVersion=1.7.0-local.20261012143005
  (or -p:DevHubSdkVersion=*-* for the newest one, local packs included).
-->
<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DevHub</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Every DLL of the plugin goes into its package; nothing else is copied. -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

        <DevHubSdkVersion Condition="'$(DevHubSdkVersion)' == ''">*</DevHubSdkVersion>
        <DevHubLocalFeed Condition="'$(DevHubLocalFeed)' == ''">$(MSBuildThisFileDirectory)..\local-feed\</DevHubLocalFeed>
        <RestoreAdditionalProjectSources Condition="Exists('$(DevHubLocalFeed)')">$(DevHubLocalFeed)</RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DevHub.Sdk" Version="$(DevHubSdkVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="DevHub.Sdk.Core" Version="$(DevHubSdkVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Avalonia" Version="12.1.3" ExcludeAssets="runtime" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
