<Project Sdk="Microsoft.NET.Sdk">

    <!--
      What every DevHub UI part builds on (the shell and, from P3/P4, every plugin): base classes
      for ViewModels, documents, tool windows, dialogs and settings pages; the action system
      (AppAction, IActionProvider, ActionRegistry, {a:Action} markup); the service interfaces
      (dialogs, status, theme); the design system (Themes/, Controls/, Assets/Icons/).
      It never references the app or any plugin.
    -->

    <PropertyGroup>
        <RootNamespace>DevHub</RootNamespace>
        <!-- MVVM: compiled bindings everywhere (needs x:DataType on each view). -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    </ItemGroup>

    <ItemGroup>
        <!-- Icons are loaded at runtime via avares://DevHub.Sdk/Assets/Icons/... -->
        <AvaloniaResource Include="Assets\**\*.svg" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shell is the host: it may set the host-only (internal) members of the base classes,
             e.g. DocumentViewModelBase.CloseCommand or ToolWindowViewModelBase.Shortcut. Plugins can't. -->
        <InternalsVisibleTo Include="DevHub.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevHub.Sdk.Core\DevHub.Sdk.Core.csproj" />
    </ItemGroup>

</Project>
