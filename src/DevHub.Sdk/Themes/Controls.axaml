<!--
  Control styles on top of Fluent's ControlThemes.

  Fluent's ControlTheme (its "template + defaults" for each control) stays in charge of
  how a control is built; these Styles only change sizes and add variants. A Style setter
  beats a ControlTheme setter, so these win without re-templating anything.

  Sizes use DynamicResource so swapping in Sizes.Compact.axaml resizes everything live.
  Colors are NOT set here: they come from FluentMapping.axaml.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:DevHub.Localization"
        xmlns:c="using:DevHub.Controls">

    <!-- ===== DevHub controls ===== -->
    <!-- Icons default to the 16px token; set Width/Height locally for e.g. 20px stripe icons. -->
    <Style Selector="c|Icon">
        <Setter Property="Width" Value="{DynamicResource Size.Icon}" />
        <Setter Property="Height" Value="{DynamicResource Size.Icon}" />
    </Style>

    <!-- SearchField (a TextBox with the "search" class). <Template> makes a new child per
         TextBox; a plain control value would be one instance shared by every search box.
         Same technique Fluent uses for TextBox's own clearButton class. -->
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <c:Icon Kind="search" Margin="{DynamicResource Margin.InnerLeft}" />
            </Template>
        </Setter>
    </Style>
    <!-- :empty is a TextBox pseudo-class (no text); show the clear button otherwise. -->
    <Style Selector="TextBox.search:not(:empty)">
        <Setter Property="InnerRightContent">
            <Template>
                <c:ActionButton IconKind="close"
                                Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Margin="{DynamicResource Margin.InnerRight}"
                                ToolTip.Tip="{l:T 'Clear (Esc)'}"
                                Command="{Binding $parent[TextBox].Clear}" />
            </Template>
        </Setter>
    </Style>

    <!-- ===== Sizing of stock controls ===== -->
    <!-- Trees fit their panel: rows are laid out at its width, so long names end in "…" and the fold arrows and
         badges at a row's end stay in view (a tree that scrolled sideways pushed them out of the panel). -->
    <Style Selector="TreeView">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="Button, ToggleButton, RepeatButton">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ButtonHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Fluent leaves this at the default (Stretch), so a button wider than its text
             (e.g. MinWidth="80" for OK) shows the label at the left. -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- One selector per type below: a comma list is typed as the types' common base
         class (Button works above because ToggleButton/RepeatButton derive from it), and
         e.g. TextBox + ComboBox only share TemplatedControl, which has no
         VerticalContentAlignment. -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ButtonHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.TextBox}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ButtonHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.TextBox}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Size.RowHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.ListItem}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Size.RowHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.ListItem}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Shell ===== -->
    <!-- With the client area extended into the title bar, Avalonia draws the window title
         text on top of our content (top-left). Our main toolbar shows the name itself, so
         fade the drawn one out. (IsVisible on the panel is set by a TemplateBinding, which
         outranks styles, so Opacity on the TextBlock is the lever we have.) -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- Avalonia 12 also draws a 4th caption button, "full screen", left of minimize. Native
         Windows and JetBrains IDEs don't have one, and it would sit on top of our toolbar.
         Collapsed to zero width rather than IsVisible=False: hiding it left its slot empty
         at the right edge (min/max/close shifted one place left; measured via UI Automation).
         The -2 right margin cancels the caption StackPanel's Spacing="2" after it.
         A Style outranks the button's ControlTheme, so these setters win. -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
        <Setter Property="Width" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,-2,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Tool-window stripe buttons: an ActionButton with the "stripe" class; "active" while its
         tool window is open (Classes.active="{Binding IsOpen}"). -->
    <Style Selector="c|ActionButton.stripe">
        <Setter Property="Width" Value="{DynamicResource Size.StripeButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.StripeButton}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|ActionButton.stripe /template/ c|Icon">
        <Setter Property="Width" Value="{DynamicResource Size.StripeIcon}" />
        <Setter Property="Height" Value="{DynamicResource Size.StripeIcon}" />
    </Style>
    <Style Selector="c|ActionButton.stripe.active">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.SelectionInactive}" />
    </Style>

    <!-- ===== Editor tabs: <ListBox Classes="tabs"> =====
         A ListBox laid out horizontally: selection = active tab (two-way bound), and it brings
         keyboard and accessibility support for free. JetBrains look: the strip sits on the panel
         color (set by its host in MainWindow), the active tab has the editor color so it joins the
         content below, plus an accent underline; the × shows on the active and hovered tab only.
         These Styles override the Fluent ListBoxItem ControlTheme (styles always win). -->
    <Style Selector="ListBox.tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource Size.TabHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Tab}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Editor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Editor}" />
    </Style>
    <!-- Close button: small, and only visible on the active or hovered tab (keeps its space). -->
    <Style Selector="c|ActionButton.tabClose">
        <Setter Property="Width" Value="{DynamicResource Size.TabCloseButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.TabCloseButton}" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected c|ActionButton.tabClose, ListBox.tabs > ListBoxItem:pointerover c|ActionButton.tabClose">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Editor area around the active document: padded, unless the document fills it itself. -->
    <Style Selector="Border.documentHost">
        <Setter Property="Padding" Value="{DynamicResource Padding.Document}" />
    </Style>
    <Style Selector="Border.documentHost.fill">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Flat, text-only buttons in the status bar ("Dark", "Compact"…). -->
    <Style Selector="Button.statusWidget">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Padding.StatusWidget}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Button.statusWidget:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- Flat text buttons in pane headers ("Stage All", "Discard…"): accent text, no frame,
         a tint on hover. For actions that need a word, not just an icon. -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.ActionButton}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.StatusWidget}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Selection}" />
    </Style>
    <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    </Style>

    <!-- Destructive primary button (a dialog's "Discard"): the error color instead of accent. -->
    <Style Selector="Button.accent.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Error}" />
    </Style>
    <Style Selector="Button.accent.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Error}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ===== Text variants: <TextBlock Classes="header" /> etc. ===== -->
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Header}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Date pickers mark today in their drop-down calendar. Avalonia 12's CalendarDatePicker registers
         IsTodayHighlighted without a default (false), although its docs say true. -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="IsTodayHighlighted" Value="True" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
    </Style>
    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Code}" />
    </Style>
    <Style Selector="TextBox.code">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Code}" />
    </Style>

</Styles>
