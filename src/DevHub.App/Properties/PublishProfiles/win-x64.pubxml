<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-contained Windows build (no .NET install needed):
    dotnet publish src/DevHub.App -p:PublishProfile=win-x64
  Output: artifacts/publish/win-x64 (zip that folder to hand it out).
  Not single-file and not trimmed: PluginHost loads plugins by reflection from plugin folders (plugins\ next to
  the exe: release.yml adds the bundled ones with build/Get-BundledPlugins.ps1), and they use any part of the Sdk.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
