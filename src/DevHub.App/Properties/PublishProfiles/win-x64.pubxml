<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-contained Windows build (no .NET install needed):
    dotnet publish src/DevHub.App -p:PublishProfile=win-x64
  Output: artifacts/publish/win-x64 (zip that folder to hand it out).
  Not single-file and not trimmed: PluginHost finds the plugins as DevHub*.dll files next to the exe
  and loads them by reflection, and the built-in templates are a folder (BuiltInTemplates) beside it.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
