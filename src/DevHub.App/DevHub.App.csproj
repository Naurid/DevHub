<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>DevHub</RootNamespace>
        <AssemblyName>DevHub.App</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Icon baked into the .exe (Explorer/Start menu). Static: Windows reads it from the
             file, so it can't follow the accent. The window icon is rendered at runtime. -->
        <ApplicationIcon>Assets\Logo\devhub.ico</ApplicationIcon>
        <!-- MVVM: use compiled bindings everywhere (needs x:DataType on each view). -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shell builds on the Sdk (base classes, actions, design system; icons live there too). -->
        <ProjectReference Include="..\DevHub.Sdk\DevHub.Sdk.csproj" />
        <ProjectReference Include="..\DevHub.Sdk.Core\DevHub.Sdk.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The plugins that ship with DevHub: referenced only so they're built and copied next to the
          app, where PluginHost finds them. The "plugins" alias keeps their types out of the shell's
          code (they'd need `extern alias plugins;`, which the shell must never use): the shell
          knows plugins only through IPlugin and the extension points.
        -->
        <ProjectReference Include="..\..\plugins\DevHub.Projects\DevHub.Projects.csproj" Aliases="plugins" />
        <ProjectReference Include="..\..\plugins\DevHub.Git\DevHub.Git.csproj" Aliases="plugins" />
        <ProjectReference Include="..\..\plugins\DevHub.GitHub\DevHub.GitHub.csproj" Aliases="plugins" />
        <ProjectReference Include="..\..\plugins\DevHub.Templates\DevHub.Templates.csproj" Aliases="plugins" />
    </ItemGroup>
</Project>
