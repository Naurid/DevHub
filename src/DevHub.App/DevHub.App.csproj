<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>DevHub</RootNamespace>
        <AssemblyName>DevHub.App</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Icon baked into the .exe (Explorer/Start menu). Static: Windows reads it from the
             file, so it can't follow the accent. The window icon is rendered at runtime. -->
        <ApplicationIcon>Assets\Logo\devhub.ico</ApplicationIcon>
        <!-- MVVM: use compiled bindings everywhere (needs x:DataType on each view). -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
        <!-- Installer hooks and in-app updates from GitHub Releases (docs/RELEASING.md). -->
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shell builds on the Sdk (base classes, actions, design system; icons live there too). -->
        <ProjectReference Include="..\DevHub.Sdk\DevHub.Sdk.csproj" />
        <ProjectReference Include="..\DevHub.Sdk.Core\DevHub.Sdk.Core.csproj" />
    </ItemGroup>

    <!--
      The plugins DevHub bundles (Projects, Git, GitHub, Templates) live in Naurid/DevHub-Plugins: they come from
      its marketplace index (build/Get-BundledPlugins.ps1, build/bundled-plugins.json), into plugins\ next to the
      app, where PluginHost finds them; release.yml puts them in the installer. A Debug build fetches them once
      into its output, so `dotnet run` has them (run the script again to update them); offline it warns and
      DevHub starts without them. -p:DevHubBundledPlugins=false skips it (e.g. when you load plugins from their
      build folders with DEVHUB_PLUGIN_PATHS).
    -->
    <Target Name="FetchBundledPlugins" AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' And '$(DevHubBundledPlugins)' != 'false' And !Exists('$(OutDir)plugins') And '$(CI)' != 'true' And '$(GITHUB_ACTIONS)' != 'true'">
        <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\build\Get-BundledPlugins.ps1&quot; -Out &quot;$(OutDir)plugins&quot;"
              IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
            <Output TaskParameter="ExitCode" PropertyName="_BundledPluginsExit" />
        </Exec>
        <!-- Not a warning: a build without network (or with warnings as errors) still works; DevHub just starts without them. -->
        <Message Condition="'$(_BundledPluginsExit)' != '0'" Importance="high"
                 Text="DevHub: the bundled plugins couldn't be fetched (see above); DevHub starts without them. Build again when online, or run build/Get-BundledPlugins.ps1." />
    </Target>
</Project>
