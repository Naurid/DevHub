<!--
  A 1px line with a wider invisible grab area. The thumb is 5px wide/tall so it's easy to hit;
  only the 1px Border is drawn, on the side that touches the panel, so the line and its accent
  highlight sit right against the tool window. Invert=True means the panel is to the right / below.
  Layout: a negative margin makes it take only 1px (the line); the other 4px of grab area overlap
  the neighbouring content (transparent), and ZIndex keeps them on top so they can still be grabbed.
  Without that, the 4px showed the window background as a stripe between the panels.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DevHub.Controls">

    <ControlTheme x:Key="{x:Type c:SplitterThumb}" TargetType="c:SplitterThumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="5" />
        <Setter Property="Margin" Value="0,0,-4,0" />
        <Setter Property="ZIndex" Value="1" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="PART_Line"
                            Background="{DynamicResource Brush.Border}"
                            Width="1" HorizontalAlignment="Left" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,0,0,-4" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ Border#PART_Line">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Panel on the other side: put the line there. -->
        <Style Selector="^[Invert=True]">
            <Setter Property="Margin" Value="-4,0,0,0" />
        </Style>
        <Style Selector="^[Orientation=Horizontal][Invert=True]">
            <Setter Property="Margin" Value="0,-4,0,0" />
        </Style>
        <Style Selector="^[Invert=True] /template/ Border#PART_Line">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^[Orientation=Horizontal][Invert=True] /template/ Border#PART_Line">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- Highlight while hovering and while dragging (pressed) so the grab area is discoverable. -->
        <Style Selector="^:pointerover /template/ Border#PART_Line, ^:pressed /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
