<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DevHub.Controls">

    <ControlTheme x:Key="{x:Type c:EmptyState}" TargetType="c:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <c:Icon Kind="{TemplateBinding IconKind}"
                            Width="{DynamicResource Size.EmptyStateIcon}"
                            Height="{DynamicResource Size.EmptyStateIcon}"
                            HorizontalAlignment="Center"
                            IsVisible="{TemplateBinding IconKind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{TemplateBinding Title}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Classes="small secondary"
                               Text="{TemplateBinding Description}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Actions (e.g. a Button), only when Content is set. -->
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      Margin="0,4,0,0"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
