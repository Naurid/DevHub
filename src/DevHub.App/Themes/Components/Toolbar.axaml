<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DevHub.Controls">

    <ControlTheme x:Key="{x:Type c:Toolbar}" TargetType="c:Toolbar">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Toolbar}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- PART_ItemsPresenter is the name ItemsControl looks for to host its items. -->
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:ToolbarSeparator}" TargetType="c:ToolbarSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Size.ToolbarSeparator}" />
        <Setter Property="Margin" Value="{DynamicResource Margin.ToolbarSeparator}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
