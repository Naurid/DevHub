<!--
  ControlTheme = the control's template (what it's built from) + its default property values
  + its state styles (^:pointerover etc.). Keyed by the control's type, so every ActionButton
  picks it up automatically. "^" means "the control this theme is applied to".
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DevHub.Controls">

    <ControlTheme x:Key="{x:Type c:ActionButton}" TargetType="c:ActionButton">
        <Setter Property="Width" Value="{DynamicResource Size.ActionButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.ActionButton}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <c:Icon Name="PART_Icon"
                            Kind="{TemplateBinding IconKind}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.SelectionInactive}" />
        </Style>
        <!-- No :disabled style needed: the Icon fades itself when its button is disabled
             (see Icon.UpdateDisabledLook), and the background is transparent anyway. -->
    </ControlTheme>

</ResourceDictionary>
