<!--
  Entry point for DevHub's design system. App.axaml merges only this file.
  Order matters: later dictionaries can override earlier keys.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Colors.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Fonts.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Sizes.axaml" />
        <!-- Points Fluent's keys at the tokens above. -->
        <ResourceInclude Source="avares://DevHub.App/Themes/FluentMapping.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
