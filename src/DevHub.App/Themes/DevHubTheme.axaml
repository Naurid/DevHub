<!--
  Entry point for DevHub's design system. App.axaml merges only this file.
  Order matters: later dictionaries can override earlier keys.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Colors.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Fonts.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Tokens/Sizes.axaml" />
        <!-- Points Fluent's keys at the tokens above. -->
        <ResourceInclude Source="avares://DevHub.App/Themes/FluentMapping.axaml" />
        <!-- ControlThemes for DevHub's own controls (Controls/*.cs). -->
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/ActionButton.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/Toolbar.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/ToolWindowFrame.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/EmptyState.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/SettingsRow.axaml" />
        <ResourceInclude Source="avares://DevHub.App/Themes/Components/Badge.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
