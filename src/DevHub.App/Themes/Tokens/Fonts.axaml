<!--
  Font tokens. Same in Dark and Light, so no ThemeDictionaries here.
  Views use {DynamicResource Font.*} / {DynamicResource FontSize.*}.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Families. Inter is bundled via Avalonia.Fonts.Inter (.WithInterFont() in Program.cs). -->
    <FontFamily x:Key="Font.UI">fonts:Inter#Inter</FontFamily>
    <!-- Comma list = fallbacks, tried left to right. JetBrains Mono is not bundled yet
         (vendoring it is part of UI-0), so the installed Windows monospace fonts back it up. -->
    <FontFamily x:Key="Font.Code">JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Sizes. x:Double because FontSize is a double. -->
    <x:Double x:Key="FontSize.Small">12</x:Double>
    <x:Double x:Key="FontSize.Body">13</x:Double>
    <x:Double x:Key="FontSize.Code">13</x:Double>
    <x:Double x:Key="FontSize.Header">16</x:Double>

</ResourceDictionary>
