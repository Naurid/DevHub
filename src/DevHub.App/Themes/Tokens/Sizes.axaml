<!--
  Size tokens (Normal density). Sizes.Compact.axaml overrides some of these keys;
  it gets merged *after* this file when Compact mode is on, and later keys win.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Heights / widths: x:Double -->
    <x:Double x:Key="Size.RowHeight">24</x:Double>
    <x:Double x:Key="Size.ButtonHeight">28</x:Double>
    <x:Double x:Key="Size.ToolbarHeight">40</x:Double>
    <x:Double x:Key="Size.ToolWindowHeaderHeight">40</x:Double>
    <x:Double x:Key="Size.StatusBarHeight">30</x:Double>
    <x:Double x:Key="Size.StripeWidth">40</x:Double>
    <x:Double x:Key="Size.Icon">16</x:Double>
    <x:Double x:Key="Size.StripeIcon">20</x:Double>
    <!-- Components (UI-0 step 4) -->
    <x:Double x:Key="Size.ActionButton">26</x:Double>
    <x:Double x:Key="Size.ToolbarSeparator">16</x:Double>
    <x:Double x:Key="Size.EmptyStateIcon">32</x:Double>
    <x:Double x:Key="Size.SettingsLabel">200</x:Double>
    <x:Double x:Key="Size.BadgeHeight">18</x:Double>
    <!-- Shell (UI-0 step 6) -->
    <!-- Room kept free on the right of the title bar for the window's min/max/close buttons
         (Avalonia draws them on top of our content: 3 × 45px + gaps). -->
    <x:Double x:Key="Size.CaptionButtonsReserve">142</x:Double>
    <!-- Tool-window stripe buttons (inside the Size.StripeWidth strip). -->
    <x:Double x:Key="Size.StripeButton">30</x:Double>
    <!-- Editor area (UI-0 step 8) -->
    <x:Double x:Key="Size.TabHeight">36</x:Double>
    <x:Double x:Key="Size.TabCloseButton">18</x:Double>
    <x:Double x:Key="Size.WelcomeWidth">440</x:Double>
    <x:Double x:Key="Size.WelcomeLogo">56</x:Double>
    <!-- Git: the sidebar inside a repository tab. -->
    <x:Double x:Key="Size.RepositorySidebar">240</x:Double>
    <!-- Find Action popup (UI-0 step 10) -->
    <x:Double x:Key="Size.FindActionWidth">580</x:Double>
    <x:Double x:Key="Size.FindActionMaxHeight">460</x:Double>
    <!-- Fluent key (not a DevHub token): height of those caption buttons. Kept equal to
         Size.ToolbarHeight so they fill the title bar; overridden in Compact too. -->
    <x:Double x:Key="CaptionButtonHeight">40</x:Double>

    <!-- Gaps between children (StackPanel.Spacing, Grid.RowSpacing): a single number,
         so x:Double, not Thickness. -->
    <x:Double x:Key="Spacing.Small">4</x:Double>
    <x:Double x:Key="Spacing">8</x:Double>
    <x:Double x:Key="Spacing.Large">16</x:Double>
    <!-- Between icon buttons in a toolbar. -->
    <x:Double x:Key="Spacing.Toolbar">2</x:Double>

    <!-- Padding / margins: Thickness ("left,top,right,bottom", or "horizontal,vertical") -->
    <Thickness x:Key="Padding.Button">12,4</Thickness>
    <Thickness x:Key="Padding.TextBox">8,4</Thickness>
    <!-- Vertical 0: the height tokens above already set how tall these are. -->
    <Thickness x:Key="Padding.ToolWindowHeader">12,0,8,0</Thickness>
    <Thickness x:Key="Padding.ListItem">8,0</Thickness>
    <Thickness x:Key="Padding.Toolbar">8,0</Thickness>
    <Thickness x:Key="Padding.Dialog">20,16</Thickness>
    <Thickness x:Key="Padding.SettingsRow">0,6</Thickness>
    <Thickness x:Key="Padding.Badge">6,0</Thickness>
    <!-- Gap between a TextBox's inner icon/button and the field's border. Fluent puts
         InnerLeft/RightContent outside the Padding (Padding only wraps the text column),
         so the gap to the text already comes from Padding.TextBox; these add the outer gap. -->
    <Thickness x:Key="Margin.InnerLeft">8,0,0,0</Thickness>
    <Thickness x:Key="Margin.InnerRight">0,0,6,0</Thickness>
    <Thickness x:Key="Margin.ToolbarSeparator">4,0</Thickness>
    <Thickness x:Key="Padding.StatusBar">8,0</Thickness>
    <Thickness x:Key="Padding.StatusWidget">6,0</Thickness>
    <Thickness x:Key="Padding.Tab">12,0,6,0</Thickness>
    <!-- Around a document's content in the editor area. -->
    <Thickness x:Key="Padding.Document">28,24</Thickness>
    <!-- Find Action popup: just below the title bar. -->
    <Thickness x:Key="Margin.FindAction">0,64,0,0</Thickness>
    <!-- Inside popups (Find Action). A Thickness: Padding/Margin need one, not a Spacing.* double
         (DynamicResource types are only checked at runtime; a double here crashed the app). -->
    <Thickness x:Key="Padding.Popup">4</Thickness>
    <!-- Git (G0) -->
    <!-- Gap between the title-bar breadcrumb and the branch widget. -->
    <Thickness x:Key="Margin.BranchWidget">12,0,0,0</Thickness>
    <!-- Space below a block in a document (e.g. the repository header). -->
    <Thickness x:Key="Margin.BlockBelow">0,0,0,12</Thickness>
    <!-- Keeps the last item of a tree/list row (language, count badge) off the panel's edge. -->
    <Thickness x:Key="Margin.RowEnd">0,0,8,0</Thickness>
    <!-- Header block at the top of a sidebar (repository name, path, branch). -->
    <Thickness x:Key="Padding.SidebarHeader">12,12,12,8</Thickness>

    <!-- Rounded corners: CornerRadius -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">8</CornerRadius>
    <!-- Large value = pill shape; it's clamped to half the badge height. -->
    <CornerRadius x:Key="Radius.Badge">10</CornerRadius>

</ResourceDictionary>
