<!--
  Color tokens. Views never use hex values; they use the Brush.* keys below via
  DynamicResource so Dark/Light (and a changed accent) apply at runtime.

  Naming: Color.<Role> holds the raw Color (needed later for Fluent key mapping
  and gradients); Brush.<Role> is what views bind to.
  Roles describe *purpose*, not appearance: Bg.Panel, not "DarkGrey2".
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent is the same in both themes and user-configurable, so it lives
         outside ThemeDictionaries. Settings will overwrite this key at runtime. -->
    <Color x:Key="Color.Accent">#3574F0</Color>
    <!-- Derived from Color.Accent; ThemeService recomputes both when the accent changes. -->
    <Color x:Key="Color.Accent.Hover">#366ACE</Color>
    <Color x:Key="Color.Accent.Pressed">#2F5EB9</Color>

    <ResourceDictionary.ThemeDictionaries>

        <!-- Rider "New UI" Dark -->
        <ResourceDictionary x:Key="Dark">
            <!-- Backgrounds, from back to front -->
            <Color x:Key="Color.Bg.Editor">#1E1F22</Color>
            <Color x:Key="Color.Bg.Panel">#2B2D30</Color>
            <Color x:Key="Color.Bg.Popup">#2B2D30</Color>
            <Color x:Key="Color.Bg.Hover">#393B40</Color>
            <Color x:Key="Color.Bg.Selection">#2E436E</Color>
            <Color x:Key="Color.Bg.SelectionInactive">#43454A</Color>

            <Color x:Key="Color.Border">#1E1F22</Color>
            <!-- A line between two areas on the editor color (Color.Border would vanish there in Dark). -->
            <Color x:Key="Color.Separator">#393B40</Color>
            <Color x:Key="Color.Border.Control">#4E5157</Color>

            <Color x:Key="Color.Text.Primary">#DFE1E5</Color>
            <Color x:Key="Color.Text.Secondary">#868A91</Color>
            <Color x:Key="Color.Text.Disabled">#5A5D63</Color>
            <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

            <Color x:Key="Color.Status.Error">#DB5C5C</Color>
            <Color x:Key="Color.Status.Warning">#F2C55C</Color>
            <Color x:Key="Color.Status.Success">#5FAD65</Color>

            <!-- Commit graph lines (G5): one color per branch line, cycled. -->
            <Color x:Key="Color.Graph.0">#548AF7</Color>
            <Color x:Key="Color.Graph.1">#5FAD65</Color>
            <Color x:Key="Color.Graph.2">#E08855</Color>
            <Color x:Key="Color.Graph.3">#A571E6</Color>
            <Color x:Key="Color.Graph.4">#3FB2BD</Color>
            <Color x:Key="Color.Graph.5">#E06BAF</Color>
            <Color x:Key="Color.Graph.6">#D6AE58</Color>
            <Color x:Key="Color.Graph.7">#DB5C5C</Color>
        </ResourceDictionary>

        <!-- Rider "New UI" Light: same keys, different values. Every key in
             Dark must exist here too, or Light falls back to nothing. -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Color.Bg.Editor">#FFFFFF</Color>
            <Color x:Key="Color.Bg.Panel">#F7F8FA</Color>
            <Color x:Key="Color.Bg.Popup">#FFFFFF</Color>
            <Color x:Key="Color.Bg.Hover">#DFE1E5</Color>
            <Color x:Key="Color.Bg.Selection">#D5E1FF</Color>
            <Color x:Key="Color.Bg.SelectionInactive">#DFE1E5</Color>

            <Color x:Key="Color.Border">#EBECF0</Color>
            <Color x:Key="Color.Separator">#EBECF0</Color>
            <Color x:Key="Color.Border.Control">#C9CCD6</Color>

            <Color x:Key="Color.Text.Primary">#000000</Color>
            <Color x:Key="Color.Text.Secondary">#6C707E</Color>
            <Color x:Key="Color.Text.Disabled">#A8ADBD</Color>
            <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

            <Color x:Key="Color.Status.Error">#E55765</Color>
            <Color x:Key="Color.Status.Warning">#E2A53A</Color>
            <Color x:Key="Color.Status.Success">#208A3C</Color>

            <Color x:Key="Color.Graph.0">#3574F0</Color>
            <Color x:Key="Color.Graph.1">#208A3C</Color>
            <Color x:Key="Color.Graph.2">#D46A1D</Color>
            <Color x:Key="Color.Graph.3">#834DF0</Color>
            <Color x:Key="Color.Graph.4">#078A96</Color>
            <Color x:Key="Color.Graph.5">#C94F9A</Color>
            <Color x:Key="Color.Graph.6">#B38A0F</Color>
            <Color x:Key="Color.Graph.7">#E55765</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Brushes are declared once. DynamicResource makes each one look up the
         Color for the *current* theme variant, so they follow Dark/Light. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />

    <SolidColorBrush x:Key="Brush.Bg.Editor" Color="{DynamicResource Color.Bg.Editor}" />
    <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{DynamicResource Color.Bg.Panel}" />
    <SolidColorBrush x:Key="Brush.Bg.Popup" Color="{DynamicResource Color.Bg.Popup}" />
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="{DynamicResource Color.Bg.Hover}" />
    <SolidColorBrush x:Key="Brush.Bg.Selection" Color="{DynamicResource Color.Bg.Selection}" />
    <SolidColorBrush x:Key="Brush.Bg.SelectionInactive" Color="{DynamicResource Color.Bg.SelectionInactive}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Separator" Color="{DynamicResource Color.Separator}" />
    <SolidColorBrush x:Key="Brush.Border.Control" Color="{DynamicResource Color.Border.Control}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{DynamicResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Brush.Status.Error" Color="{DynamicResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{DynamicResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{DynamicResource Color.Status.Success}" />

    <!-- Subtle tints (badge/banner backgrounds): the same color at low opacity, so they
         work on both Dark and Light without separate values. -->
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{DynamicResource Color.Accent}" Opacity="0.2" />
    <SolidColorBrush x:Key="Brush.Status.Error.Subtle" Color="{DynamicResource Color.Status.Error}" Opacity="0.2" />
    <SolidColorBrush x:Key="Brush.Status.Warning.Subtle" Color="{DynamicResource Color.Status.Warning}" Opacity="0.25" />
    <SolidColorBrush x:Key="Brush.Status.Success.Subtle" Color="{DynamicResource Color.Status.Success}" Opacity="0.2" />

    <!-- Diff lines (G2): added green, removed red, hunk headers a faint accent, like JetBrains'
         unified diff. Fainter than the badge tints: whole screens of them must stay readable. -->
    <SolidColorBrush x:Key="Brush.Diff.Added" Color="{DynamicResource Color.Status.Success}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Diff.Removed" Color="{DynamicResource Color.Status.Error}" Opacity="0.16" />
    <SolidColorBrush x:Key="Brush.Diff.Hunk" Color="{DynamicResource Color.Accent}" Opacity="0.1" />

    <!-- Commit graph (G5). CommitGraphCell looks these up by index: Brush.Graph.{color % 8}. -->
    <SolidColorBrush x:Key="Brush.Graph.0" Color="{DynamicResource Color.Graph.0}" />
    <SolidColorBrush x:Key="Brush.Graph.1" Color="{DynamicResource Color.Graph.1}" />
    <SolidColorBrush x:Key="Brush.Graph.2" Color="{DynamicResource Color.Graph.2}" />
    <SolidColorBrush x:Key="Brush.Graph.3" Color="{DynamicResource Color.Graph.3}" />
    <SolidColorBrush x:Key="Brush.Graph.4" Color="{DynamicResource Color.Graph.4}" />
    <SolidColorBrush x:Key="Brush.Graph.5" Color="{DynamicResource Color.Graph.5}" />
    <SolidColorBrush x:Key="Brush.Graph.6" Color="{DynamicResource Color.Graph.6}" />
    <SolidColorBrush x:Key="Brush.Graph.7" Color="{DynamicResource Color.Graph.7}" />

</ResourceDictionary>
