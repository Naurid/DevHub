<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevHub.ViewModels"
        xmlns:pages="clr-namespace:DevHub.ViewModels.Pages"
        xmlns:c="clr-namespace:DevHub.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="DevHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DevHub"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Styles>
        <!-- Sidebar nav rows: flat, rounded, accent highlight when selected. -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- Selected: green left-edge bar + subtle tinted fill, sharp corners. -->
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,16" Spacing="2">
                    <TextBlock Text="DevHub" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Project &amp; template workbench" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Nav -->
                <ListBox Classes="nav"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:PageViewModelBase">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <c:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Padding="28">
            <ContentControl Content="{Binding SelectedPage}" />
        </Border>
    </Grid>
</Window>
