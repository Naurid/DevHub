<!--
  Debug UI Gallery: every color token and stock control, in the current theme.
  Only tokens here (no hex/sizes/fonts) except the accent presets, which are data.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:DevHub.ViewModels.Documents"
             xmlns:c="clr-namespace:DevHub.Controls"
             xmlns:a="clr-namespace:DevHub.Actions"
             x:Class="DevHub.Views.Documents.UiGalleryView"
             x:DataType="docs:UiGalleryViewModel">

    <UserControl.Styles>
        <!-- One color sample. -->
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="WrapPanel.swatches > StackPanel">
            <Setter Property="Spacing" Value="{DynamicResource Spacing.Small}" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <!-- A titled block of the gallery. -->
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Popup}" />
            <Setter Property="Padding" Value="{DynamicResource Padding.Dialog}" />
        </Style>
        <!-- Accent preset dots. -->
        <Style Selector="Button.accentPreset">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.accentPreset > Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="{DynamicResource Spacing.Large}" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="{DynamicResource Spacing.Small}">
                <TextBlock Classes="header" Text="UI Gallery" />
                <TextBlock Classes="secondary"
                           Text="Debug only. Every token and stock control in the current theme." />
            </StackPanel>

            <!-- ===== Appearance switches ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Appearance" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Large}">
                        <ToggleSwitch IsChecked="{Binding IsDark}" OnContent="Dark" OffContent="Light" />
                        <CheckBox IsChecked="{Binding IsCompact}" Content="Compact" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}">
                        <TextBlock Classes="secondary" Text="Accent" VerticalAlignment="Center" />
                        <Button Classes="accentPreset" Command="{Binding SetAccentCommand}" CommandParameter="#3574F0"
                                ToolTip.Tip="JetBrains blue (default)">
                            <Border Background="#3574F0" />
                        </Button>
                        <Button Classes="accentPreset" Command="{Binding SetAccentCommand}" CommandParameter="#25A146"
                                ToolTip.Tip="Green (old DevHub)">
                            <Border Background="#25A146" />
                        </Button>
                        <Button Classes="accentPreset" Command="{Binding SetAccentCommand}" CommandParameter="#8C5CDB"
                                ToolTip.Tip="Purple">
                            <Border Background="#8C5CDB" />
                        </Button>
                        <Button Classes="accentPreset" Command="{Binding SetAccentCommand}" CommandParameter="#E0802B"
                                ToolTip.Tip="Orange">
                            <Border Background="#E0802B" />
                        </Button>
                        <TextBlock Classes="code secondary" Text="{Binding Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Color tokens ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Colors" />
                    <WrapPanel Classes="swatches">
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Accent}" /><TextBlock Classes="small secondary" Text="Accent" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Accent.Hover}" /><TextBlock Classes="small secondary" Text="Accent.Hover" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Accent.Pressed}" /><TextBlock Classes="small secondary" Text="Accent.Pressed" /></StackPanel>
                    </WrapPanel>
                    <WrapPanel Classes="swatches">
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.Editor}" /><TextBlock Classes="small secondary" Text="Bg.Editor" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.Panel}" /><TextBlock Classes="small secondary" Text="Bg.Panel" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.Popup}" /><TextBlock Classes="small secondary" Text="Bg.Popup" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.Hover}" /><TextBlock Classes="small secondary" Text="Bg.Hover" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.Selection}" /><TextBlock Classes="small secondary" Text="Bg.Selection" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Bg.SelectionInactive}" /><TextBlock Classes="small secondary" Text="Bg.SelectionInactive" /></StackPanel>
                    </WrapPanel>
                    <WrapPanel Classes="swatches">
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Border}" /><TextBlock Classes="small secondary" Text="Border" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Border.Control}" /><TextBlock Classes="small secondary" Text="Border.Control" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Text.Primary}" /><TextBlock Classes="small secondary" Text="Text.Primary" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Text.Secondary}" /><TextBlock Classes="small secondary" Text="Text.Secondary" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Text.Disabled}" /><TextBlock Classes="small secondary" Text="Text.Disabled" /></StackPanel>
                    </WrapPanel>
                    <WrapPanel Classes="swatches">
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Status.Error}" /><TextBlock Classes="small secondary" Text="Status.Error" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Status.Warning}" /><TextBlock Classes="small secondary" Text="Status.Warning" /></StackPanel>
                        <StackPanel><Border Classes="swatch" Background="{DynamicResource Brush.Status.Success}" /><TextBlock Classes="small secondary" Text="Status.Success" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Icons ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Icons" />
                    <TextBlock Classes="small secondary"
                               Text="JetBrains expui set, Apache 2.0 (Assets/Icons/NOTICE.md). Light/dark files swap with the theme." />
                    <ItemsControl ItemsSource="{Binding IconKinds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Width="104" Margin="0,0,0,12" Spacing="{DynamicResource Spacing.Small}"
                                            ToolTip.Tip="{Binding}">
                                    <c:Icon Kind="{Binding}" HorizontalAlignment="Center" />
                                    <TextBlock Classes="small secondary" Text="{Binding}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                        <TextBlock Classes="secondary" Text="20px (stripe size):" VerticalAlignment="Center" />
                        <c:Icon Kind="folder" Width="{DynamicResource Size.StripeIcon}" Height="{DynamicResource Size.StripeIcon}" />
                        <c:Icon Kind="vcs" Width="{DynamicResource Size.StripeIcon}" Height="{DynamicResource Size.StripeIcon}" />
                        <TextBlock Classes="secondary" Text="In a button:" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <Button>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}">
                                <c:Icon Kind="refresh" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== DevHub components ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing.Large}">
                    <TextBlock Classes="header" Text="Components" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Spacing.Large}">
                        <!-- ToolWindowFrame + Toolbar + ActionButton + SearchField + Badge -->
                        <c:ToolWindowFrame Header="Repositories" Height="260"
                                           BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                           CornerRadius="{DynamicResource Radius.Control}">
                            <c:ToolWindowFrame.HeaderActions>
                                <c:Toolbar>
                                    <c:ActionButton IconKind="add" ToolTip.Tip="Add folder" />
                                    <c:ActionButton IconKind="refresh" ToolTip.Tip="Rescan" />
                                    <c:ToolbarSeparator />
                                    <c:ActionButton IconKind="delete" ToolTip.Tip="Remove (disabled)" IsEnabled="False" />
                                    <c:ActionButton IconKind="moreVertical" ToolTip.Tip="More" />
                                </c:Toolbar>
                            </c:ToolWindowFrame.HeaderActions>
                            <DockPanel>
                                <c:SearchField DockPanel.Dock="Top" Margin="8,0,8,4" />
                                <ListBox ItemsSource="{Binding SampleItems}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <!-- Grid, not a horizontal StackPanel: a StackPanel gives its
                                                 children unlimited width, so the text could never trim. -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing.Small}">
                                                <c:Icon Kind="folder" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                <c:Badge Grid.Column="2" Classes="success" Content="clean" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </c:ToolWindowFrame>

                        <!-- EmptyState inside a frame -->
                        <c:ToolWindowFrame Grid.Column="1" Header="Commit" Height="260"
                                           BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                           CornerRadius="{DynamicResource Radius.Control}">
                            <c:EmptyState IconKind="commit" Title="No changes"
                                          Description="Edit files in a repository and they'll show up here.">
                                <Button Content="Refresh" />
                            </c:EmptyState>
                        </c:ToolWindowFrame>
                    </Grid>

                    <!-- Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                        <TextBlock Classes="secondary" Text="Badges:" VerticalAlignment="Center" />
                        <c:Badge Content="3" />
                        <c:Badge Classes="accent" Content="main" />
                        <c:Badge Classes="success" Content="clean" />
                        <c:Badge Classes="warning" Content="2 modified" />
                        <c:Badge Classes="error" Content="conflict" />
                    </StackPanel>

                    <!-- SettingsRow -->
                    <StackPanel>
                        <c:SettingsRow Label="Theme" Description="Applies immediately.">
                            <ToggleSwitch IsChecked="{Binding IsDark}" OnContent="Dark" OffContent="Light" />
                        </c:SettingsRow>
                        <c:SettingsRow Label="Compact mode">
                            <CheckBox IsChecked="{Binding IsCompact}" />
                        </c:SettingsRow>
                        <c:SettingsRow Label="Default clone folder" Description="Where new repositories are cloned.">
                            <TextBox Width="280" PlaceholderText="C:\Projects" />
                        </c:SettingsRow>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Actions ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Actions" />
                    <TextBlock Classes="small secondary" TextWrapping="Wrap"
                               Text="Toolbar, menu and shortcut all come from the ActionRegistry. Rescan is disabled until the Repositories page has a folder, and it greys out everywhere at once." />

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Large}">
                        <!-- Toolbar from actions: command + icon + tooltip ("Rescan (F5)"). -->
                        <c:Toolbar>
                            <c:ActionButton Action="{a:Action Repositories.AddFolder}" />
                            <c:ActionButton Action="{a:Action Repositories.Rescan}" />
                            <c:ToolbarSeparator />
                            <c:ActionButton Action="{a:Action View.ToggleTheme}" />
                        </c:Toolbar>

                        <!-- Same actions in a flyout menu, and in a context menu next to it. -->
                        <Button Content="Actions ▾">
                            <Button.Flyout>
                                <MenuFlyout ItemsSource="{a:ActionMenu 'Repositories.AddFolder,Repositories.Rescan,-,View.ToggleTheme,View.ToggleCompact'}" />
                            </Button.Flyout>
                        </Button>
                        <Border Background="{DynamicResource Brush.Bg.Editor}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="{DynamicResource Padding.Button}">
                            <Border.ContextMenu>
                                <ContextMenu ItemsSource="{a:ActionMenu '-,ToolWindow.Repositories,App.Settings,-,-,View.ToggleTheme,-'}" />
                            </Border.ContextMenu>
                            <TextBlock Classes="secondary" Text="Right-click me" />
                        </Border>
                    </StackPanel>

                    <!-- Every registered action and its shortcut. -->
                    <ItemsControl ItemsSource="{a:ActionList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="a:AppAction">
                                <Grid ColumnDefinitions="24,260,*" Height="{DynamicResource Size.RowHeight}">
                                    <c:Icon Kind="{Binding IconKind}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="code secondary" Text="{Binding Gesture}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Typography ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Typography" />
                    <TextBlock Text="Body: Inter 13. The quick brown fox jumps over the lazy dog." />
                    <TextBlock Classes="secondary" Text="Secondary: hints, captions, inactive labels." />
                    <TextBlock Classes="small secondary" Text="Small: status bar, badges, metadata." />
                    <TextBlock Classes="code" Text="Code: JetBrains Mono → git commit -m &quot;fix: 0O 1lI&quot;" />
                    <TextBlock Foreground="{DynamicResource Brush.Status.Error}" Text="Error text" />
                </StackPanel>
            </Border>

            <!-- ===== Buttons ===== -->
            <Border Classes="section">
                <StackPanel Spacing="{DynamicResource Spacing}">
                    <TextBlock Classes="header" Text="Buttons" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                        <Button Classes="accent" Content="Primary (accent)" />
                        <Button Content="Default" ToolTip.Tip="A tooltip on Bg.Popup" />
                        <Button Content="Disabled" IsEnabled="False" />
                        <ToggleButton Content="Toggle" />
                        <Button Content="Menu ▾">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Open in Rider" InputGesture="Ctrl+O" />
                                    <MenuItem Header="Open in Explorer" />
                                    <Separator />
                                    <MenuItem Header="Remove" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Inputs ===== -->
            <Border Classes="section">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Spacing.Large}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource Spacing}">
                    <TextBlock Grid.ColumnSpan="2" Classes="header" Text="Inputs" />

                    <TextBox Grid.Row="1" Grid.Column="0" PlaceholderText="Placeholder text" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SampleItems}"
                              SelectedIndex="0" HorizontalAlignment="Stretch" />

                    <TextBox Grid.Row="2" Grid.Column="0" Text="Disabled" IsEnabled="False" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="code" Text="dotnet build -c Release" />

                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="{DynamicResource Spacing.Small}">
                        <CheckBox Content="Checked" IsChecked="True" />
                        <CheckBox Content="Unchecked" />
                        <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="{DynamicResource Spacing.Small}">
                        <RadioButton GroupName="g" Content="Option A" IsChecked="True" />
                        <RadioButton GroupName="g" Content="Option B" />
                        <ToggleSwitch IsChecked="True" OnContent="On" OffContent="Off" />
                    </StackPanel>

                    <Slider Grid.Row="4" Grid.Column="0" Value="40" />
                    <ProgressBar Grid.Row="4" Grid.Column="1" Value="40" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ===== Lists & tabs ===== -->
            <Border Classes="section">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Spacing.Large}"
                      RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Spacing}">
                    <TextBlock Grid.ColumnSpan="2" Classes="header" Text="Lists &amp; tabs" />

                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{DynamicResource Brush.Bg.Editor}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ListBox ItemsSource="{Binding SampleItems}" SelectedIndex="1" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TabControl Grid.Row="1" Grid.Column="1">
                        <TabItem Header="Changes">
                            <TextBlock Classes="secondary" Margin="0,8" Text="Tab content" />
                        </TabItem>
                        <TabItem Header="Log">
                            <TextBlock Classes="secondary" Margin="0,8" Text="Second tab" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
