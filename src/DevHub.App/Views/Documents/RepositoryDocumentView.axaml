<!--
  A repository tab (fills the editor area: FillsEditorArea = true).
  Left: Fork-style sidebar on the panel color, full height, with the repository header on top.
  Right: the selected section on the editor color. The two colors (plus the border) make the
  sidebar's edge visible in Dark and Light; a border alone matched the editor color in Dark.
  Sections are placeholders in G0 and fill in milestone by milestone.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="clr-namespace:DevHub.ViewModels.Documents"
             xmlns:c="clr-namespace:DevHub.Controls"
             x:Class="DevHub.Views.Documents.RepositoryDocumentView"
             x:DataType="docs:RepositoryDocumentViewModel">

    <Panel>
        <!-- Git not installed: nothing else can work. -->
        <c:EmptyState IconKind="warning" Title="Git is not installed"
                      Description="DevHub runs the git command-line tool. Install Git for Windows (git-scm.com), then restart DevHub."
                      IsVisible="{Binding !IsGitAvailable}" />

        <DockPanel IsVisible="{Binding IsGitAvailable}">
            <!-- Sidebar -->
            <Border DockPanel.Dock="Left" Width="{Binding Layout.SidebarWidth}"
                    Background="{DynamicResource Brush.Bg.Panel}">
                <DockPanel>
                    <!-- Repository header: name, path, branch. -->
                    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.SidebarHeader}"
                                Spacing="{DynamicResource Spacing.Small}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                            <c:Icon Kind="vcs" Width="{DynamicResource Size.StripeIcon}"
                                    Height="{DynamicResource Size.StripeIcon}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="header" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <!-- Fork's Fetch / Pull / Push buttons (also Git menu, Ctrl+T, Ctrl+Shift+K).
                                 Disabled while one runs; progress and Cancel are in the status bar. -->
                            <c:Toolbar Grid.Column="2">
                                <c:ActionButton IconKind="fetch" AutomationProperties.Name="Fetch"
                                                ToolTip.Tip="Fetch: download what's new on the remotes (changes nothing locally)"
                                                Command="{Binding Remote.FetchCommand}" />
                                <c:ActionButton IconKind="update" AutomationProperties.Name="Update"
                                                ToolTip.Tip="Update (Ctrl+T): pull the current branch's new commits"
                                                Command="{Binding Remote.PullCommand}" />
                                <c:ActionButton IconKind="push" AutomationProperties.Name="Push"
                                                ToolTip.Tip="Push… (Ctrl+Shift+K): send your commits to the remote"
                                                Command="{Binding Remote.PushCommand}" />
                            </c:Toolbar>
                        </Grid>
                        <TextBlock Classes="small secondary" Text="{Binding Path}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        <!-- A Grid, not a horizontal StackPanel: the "*" column limits the badge to the
                             sidebar width, so a long branch name ends in "…" (full name in the tooltip)
                             instead of running past the edge. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                            <c:Badge Classes="accent"
                                     IsVisible="{Binding Branch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     ToolTip.Tip="{Binding Branch, StringFormat='Current branch: {0}'}">
                                <TextBlock Text="{Binding Branch}" TextTrimming="CharacterEllipsis" />
                            </c:Badge>
                            <!-- Ahead / behind the upstream. -->
                            <TextBlock Grid.Column="1" Classes="small secondary" Text="{Binding SyncText}" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Upstream, StringFormat='Commits ahead (↑) / behind (↓) {0}'}"
                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                    </StackPanel>

                    <!-- Sections, with a count badge (Local Changes: changed files). -->
                    <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="docs:RepositorySection">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Spacing}">
                                    <c:Icon Kind="{Binding IconKind}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <c:Badge Grid.Column="2" Content="{Binding Count}" IsVisible="{Binding HasCount}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <!-- Drag to resize the sidebar (the thumb also draws its edge line). The width is
                 shared by all repository tabs. -->
            <c:SplitterThumb DockPanel.Dock="Left" Value="{Binding Layout.SidebarWidth}"
                             Minimum="160" MaximumFraction="0.4" />

            <!-- Selected section, on the editor color. -->
            <DockPanel>
                <!-- Refresh failed (e.g. the folder is no longer a git repository). -->
                <Border DockPanel.Dock="Top" Padding="{DynamicResource Padding.Banner}"
                        Background="{DynamicResource Brush.Status.Error.Subtle}"
                        IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>

                <!-- Merge / rebase / … in progress (continue and abort arrive in G7). -->
                <Border DockPanel.Dock="Top" Padding="{DynamicResource Padding.Banner}"
                        Background="{DynamicResource Brush.Status.Warning.Subtle}"
                        IsVisible="{Binding OperationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}">
                        <c:Icon Kind="warning" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OperationText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- LocalChangesViewModel → LocalChangesView (ViewLocator); a section that isn't
                     built yet → the placeholder below. -->
                <ContentControl Content="{Binding CurrentContent}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="docs:RepositorySection">
                            <c:EmptyState Margin="{DynamicResource Padding.Document}"
                                          IconKind="{Binding IconKind}" Title="{Binding Title}"
                                          Description="{Binding Placeholder}" />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </DockPanel>
        </DockPanel>
    </Panel>
</UserControl>
