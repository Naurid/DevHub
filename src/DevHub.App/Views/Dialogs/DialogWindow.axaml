<!--
  The frame every modal dialog shares: title, the dialog's own View in the middle (its
  ViewModel → View via the ViewLocator), and a footer with OK / Cancel / (Apply).
  Opened only by DialogService.ShowDialogAsync; dialogs never create windows themselves.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:DevHub.Localization"
        xmlns:vm="using:DevHub.ViewModels.Dialogs"
        x:Class="DevHub.Views.Dialogs.DialogWindow"
        x:DataType="vm:DialogViewModelBase"
        Title="{Binding Title}"
        SizeToContent="Manual"
        MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg.Panel}">

    <DockPanel>
        <!-- Footer. IsDefault = Enter presses OK; IsCancel = Esc presses Cancel (or OK, in an
             OK-only message dialog). -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="{DynamicResource Padding.Dialog}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Spacing}">
                <Button Classes="accent" Classes.danger="{Binding IsDestructive}"
                        Content="{Binding OkText}" MinWidth="80" IsDefault="True"
                        IsCancel="{Binding !ShowCancel}"
                        Command="{Binding OkCommand}" />
                <Button Content="{l:T 'Cancel'}" MinWidth="80" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding ShowCancel}" />
                <Button Content="{l:T 'Apply'}" MinWidth="80"
                        Command="{Binding ApplyCommand}"
                        IsVisible="{Binding ShowApply}" />
            </StackPanel>
        </Border>

        <!-- The dialog itself. -->
        <ContentControl Content="{Binding}" />
    </DockPanel>
</Window>
