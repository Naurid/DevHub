<!--
  Status bar: the latest message (IStatusService) on the left, widgets on the right.
  Widgets are flat text buttons (Button.statusWidget, Themes/Controls.axaml) that run
  actions, so clicking "Dark" does exactly what Ctrl+Alt+D does.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels.Shell"
             xmlns:a="using:DevHub.Actions"
             xmlns:c="using:DevHub.Controls"
             x:Class="DevHub.Views.Shell.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <Border Height="{DynamicResource Size.StatusBarHeight}"
            Background="{DynamicResource Brush.Bg.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            Padding="{DynamicResource Padding.StatusBar}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing.Large}">
            <!-- The latest message; a click shows the ones before it (Settings → Appearance: how many are kept). -->
            <Button Classes="statusWidget" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    ToolTip.Tip="{l:T 'Recent messages'}" AutomationProperties.Name="{l:T 'Recent messages'}">
                <TextBlock Text="{Binding Message, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                        <StackPanel Width="{DynamicResource Size.StatusHistoryWidth}" Spacing="{DynamicResource Spacing}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="header" Text="{l:T 'Recent messages'}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="flat" Content="{l:T 'Clear'}" Command="{Binding ClearHistoryCommand}"
                                        IsEnabled="{Binding HasHistory}" />
                            </Grid>
                            <TextBlock Classes="secondary" Text="{l:T 'No messages yet.'}" IsVisible="{Binding !HasHistory}" />
                            <ScrollViewer MaxHeight="{DynamicResource Size.StatusHistoryMaxHeight}" IsVisible="{Binding HasHistory}">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusMessage">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Spacing}"
                                                  Margin="{DynamicResource Padding.ListItem}">
                                                <TextBlock Classes="small secondary" Text="{Binding Time}" />
                                                <SelectableTextBlock Grid.Column="1" FontSize="{DynamicResource FontSize.Small}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Running operation (JetBrains' background-task indicator): title, step, bar, Cancel.
                 Bound through CurrentTask.* rather than switching DataContext: IDEs check a
                 DataContext binding against the element's own x:DataType and flag it, while
                 Avalonia's compiler checks it against the parent's. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing}"
                        IsVisible="{Binding HasTask}">
                <TextBlock Classes="small" Text="{Binding CurrentTask.Title, FallbackValue=''}" VerticalAlignment="Center" />
                <TextBlock Classes="small secondary" Text="{Binding CurrentTask.Step, FallbackValue=''}" VerticalAlignment="Center"
                           MaxWidth="{DynamicResource Size.StatusTaskStep}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Width="{DynamicResource Size.StatusProgress}" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding CurrentTask.Percent, FallbackValue=0}"
                             IsIndeterminate="{Binding CurrentTask.IsIndeterminate, FallbackValue=False}" />
                <c:ActionButton IconKind="close" ToolTip.Tip="{l:T 'Cancel'}" AutomationProperties.Name="{l:T 'Cancel'}"
                                Command="{Binding CurrentTask.CancelCommand, FallbackValue={x:Null}}"
                                IsVisible="{Binding CurrentTask.CanCancel, FallbackValue=False}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Widgets from plugins (shown through the ViewLocator), then the built-in ones. -->
                <ItemsControl ItemsSource="{Binding Widgets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Classes="statusWidget"
                        Content="{Binding DensityLabel}"
                        ToolTip.Tip="{l:T 'Toggle Compact Mode'}"
                        Command="{a:ActionCommand View.ToggleCompact}" />
                <Button Classes="statusWidget"
                        Content="{Binding ThemeLabel}"
                        ToolTip.Tip="{l:T 'Toggle Dark Theme (Ctrl+Alt+D)'}"
                        Command="{a:ActionCommand View.ToggleTheme}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
