<!--
  The merged title bar + main toolbar (Rider "New UI" style). The window's client area is
  extended into the title bar (MainWindow.axaml), so this row sits where the OS title bar
  used to be, and Avalonia draws min/max/close on top of its right edge.

  Dragging: the root Border has ElementRole="TitleBar", so empty space moves the window
  (double-click maximizes). Avalonia finds the role by walking up from the element under
  the mouse, so interactive parts need ElementRole="User" or they'd be swallowed by the
  title bar too. Gaps between buttons fall through to the Border and stay draggable.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DevHub.Localization"
             xmlns:vm="using:DevHub.ViewModels"
             xmlns:c="using:DevHub.Controls"
             xmlns:a="using:DevHub.Actions"
             x:Class="DevHub.Views.Shell.MainToolbar"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <ContainerQuery Name="titleBar" Query="max-width:900">
            <Style Selector=":is(Control).appName">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Border Height="{DynamicResource Size.ToolbarHeight}"
            Background="{DynamicResource Brush.Bg.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
            Padding="{DynamicResource Padding.Toolbar}"
            Container.Name="titleBar" Container.Sizing="Width"
            WindowDecorationProperties.ElementRole="TitleBar">
        <!-- Docked so a narrow window shrinks the breadcrumb first ("…", then clipped), and the toolbar's
             buttons go into a ⋯ menu only when even they don't fit; nothing slides under min/max/close. -->
        <DockPanel>
            <!-- Logo + main menu (☰). -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{DynamicResource Spacing}"
                        VerticalAlignment="Center">
                <c:DevHubLogo Width="{DynamicResource Size.StripeIcon}"
                              Height="{DynamicResource Size.StripeIcon}"
                              LineThickness="4" />
                <c:ActionButton IconKind="menu" ToolTip.Tip="{l:T 'Main Menu'}"
                                WindowDecorationProperties.ElementRole="User">
                    <c:ActionButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{a:MainMenu}" />
                    </c:ActionButton.Flyout>
                </c:ActionButton>
            </StackPanel>

            <!-- Keeps our buttons out from under the window's min/max/close buttons, which
                 Avalonia draws on top of this corner. -->
            <Border DockPanel.Dock="Right" Width="{DynamicResource Size.CaptionButtonsReserve}" />

            <!-- Main toolbar: every action with a ToolbarOrder (from the shell and the loaded plugins). -->
            <c:Toolbar DockPanel.Dock="Right" WindowDecorationProperties.ElementRole="User"
                       Margin="{DynamicResource Margin.InnerLeft}" ItemsSource="{a:ToolbarActions}">
                <c:Toolbar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:OverflowPanel Spacing="{DynamicResource Spacing.Toolbar}" />
                    </ItemsPanelTemplate>
                </c:Toolbar.ItemsPanel>
                <c:Toolbar.DataTemplates>
                    <DataTemplate DataType="a:AppAction">
                        <c:ActionButton Action="{Binding}" />
                    </DataTemplate>
                    <DataTemplate DataType="a:ToolbarSeparatorItem">
                        <c:ToolbarSeparator />
                    </DataTemplate>
                </c:Toolbar.DataTemplates>
            </c:Toolbar>

            <!-- "Where am I": app name › active tab (or Welcome), then plugins' widgets (Git's branch). Not
                 interactive, so it stays draggable; the space to its right is the big draggable area. -->
            <DockPanel Margin="{DynamicResource Margin.InnerLeft}" ClipToBounds="True">
                <TextBlock DockPanel.Dock="Left" Classes="appName" Text="{l:T 'DevHub'}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <c:Icon DockPanel.Dock="Left" Classes="appName" Kind="chevronRight" VerticalAlignment="Center"
                        Margin="{DynamicResource Margin.Breadcrumb}" />
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="{Binding Documents.ActiveTitle}"
                           MaxWidth="{DynamicResource Size.BreadcrumbTitleMax}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <!-- Widgets from plugins (e.g. Git's branch widget), shown through the ViewLocator. A DockPanel (each
                     widget docked left), not a StackPanel, so the last one gets the width that's left and can shrink. -->
                <ItemsControl ItemsSource="{Binding TitleBarWidgets}" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Margin="{DynamicResource Margin.InnerLeft}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
