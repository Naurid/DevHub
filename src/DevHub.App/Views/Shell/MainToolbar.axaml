<!--
  The merged title bar + main toolbar (Rider "New UI" style). The window's client area is
  extended into the title bar (MainWindow.axaml), so this row sits where the OS title bar
  used to be, and Avalonia draws min/max/close on top of its right edge.

  Dragging: the root Border has ElementRole="TitleBar", so empty space moves the window
  (double-click maximizes). Avalonia finds the role by walking up from the element under
  the mouse, so interactive parts need ElementRole="User" or they'd be swallowed by the
  title bar too. Gaps between buttons fall through to the Border and stay draggable.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevHub.ViewModels"
             xmlns:c="using:DevHub.Controls"
             xmlns:a="using:DevHub.Actions"
             xmlns:gitv="using:DevHub.Views.Git"
             x:Class="DevHub.Views.Shell.MainToolbar"
             x:DataType="vm:MainWindowViewModel">

    <Border Height="{DynamicResource Size.ToolbarHeight}"
            Background="{DynamicResource Brush.Bg.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
            Padding="{DynamicResource Padding.Toolbar}"
            WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource Spacing}">

            <!-- Logo + main menu (☰). -->
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing}"
                        VerticalAlignment="Center">
                <c:DevHubLogo Width="{DynamicResource Size.StripeIcon}"
                              Height="{DynamicResource Size.StripeIcon}"
                              LineThickness="4" />
                <c:ActionButton IconKind="menu" ToolTip.Tip="Main Menu"
                                WindowDecorationProperties.ElementRole="User">
                    <c:ActionButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{a:MainMenu}" />
                    </c:ActionButton.Flyout>
                </c:ActionButton>
            </StackPanel>

            <!-- "Where am I": app name › active tab (or Welcome). Not interactive, so it stays draggable. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}"
                        VerticalAlignment="Center">
                <TextBlock Text="DevHub" FontWeight="SemiBold" VerticalAlignment="Center" />
                <c:Icon Kind="chevronRight" VerticalAlignment="Center" />
                <TextBlock Classes="secondary" Text="{Binding Documents.ActiveTitle}" VerticalAlignment="Center" />
                <!-- Branch of the active repository tab (JetBrains' VCS widget). Click → branch
                     popup (G4). Hidden when the active tab isn't a repository. ElementRole="User":
                     clickable, not part of the draggable title bar. -->
                <Button x:Name="BranchWidget" Classes="branchWidget"
                        Margin="{DynamicResource Margin.BranchWidget}"
                        WindowDecorationProperties.ElementRole="User"
                        Command="{Binding Documents.ActiveRepository.BranchPopup.OpenCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding Documents.ActiveRepository.Branch, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                        ToolTip.Tip="{Binding Documents.ActiveRepository.Branch, StringFormat='Branch {0}: click for branches (Ctrl+Shift+`)', FallbackValue=''}"
                        AutomationProperties.Name="Branches">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Small}">
                        <c:Icon Kind="vcs" VerticalAlignment="Center" />
                        <!-- Capped so a long branch name ends in "…" instead of running into the toolbar. -->
                        <TextBlock Text="{Binding Documents.ActiveRepository.Branch}" VerticalAlignment="Center"
                                   MaxWidth="{DynamicResource Size.BranchWidgetText}" TextTrimming="CharacterEllipsis" />
                        <!-- ↑ahead ↓behind the upstream (G1). -->
                        <TextBlock Classes="small secondary" Text="{Binding Documents.ActiveRepository.SyncText}"
                                   VerticalAlignment="Center" />
                        <c:Icon Kind="chevronDown" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- The branch popup, under the widget. Light-dismiss: a click outside closes it. -->
                <Popup PlacementTarget="{Binding #BranchWidget}" Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True"
                       IsOpen="{Binding Documents.ActiveRepository.BranchPopup.IsOpen, Mode=TwoWay, FallbackValue=False}">
                    <gitv:BranchPopupView DataContext="{Binding Documents.ActiveRepository.BranchPopup}" />
                </Popup>
            </StackPanel>

            <!-- Column 2 (*) is empty: the big draggable area. -->

            <!-- Main toolbar actions. -->
            <c:Toolbar Grid.Column="3" WindowDecorationProperties.ElementRole="User">
                <c:ActionButton Action="{a:Action App.FindAction}" />
                <c:ToolbarSeparator />
                <c:ActionButton Action="{a:Action Repositories.AddFolder}" />
                <c:ActionButton Action="{a:Action Repositories.Rescan}" />
                <c:ToolbarSeparator />
                <c:ActionButton Action="{a:Action View.ToggleTheme}" />
                <c:ActionButton Action="{a:Action App.Settings}" />
            </c:Toolbar>

            <!-- Keeps our buttons out from under the window's min/max/close buttons, which
                 Avalonia draws on top of this corner. -->
            <Border Grid.Column="4" Width="{DynamicResource Size.CaptionButtonsReserve}" />
        </Grid>
    </Border>
</UserControl>
