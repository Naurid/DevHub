<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DevHub"
             x:Class="DevHub.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <!-- Maps a *ViewModel to its *View by naming convention. -->
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
      <ResourceDictionary>
        <!-- Design system (UI-0): tokens + Fluent key mapping. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://DevHub.Sdk/Themes/DevHubTheme.axaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Colors come from Themes/FluentMapping.axaml, accent from ThemeService. -->
        <FluentTheme />
        <!-- Sizes + text variants on top of Fluent's controls. -->
        <StyleInclude Source="avares://DevHub.Sdk/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
