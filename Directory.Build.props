<!--
  Settings shared by every project in the solution (MSBuild picks this file up automatically
  for every .csproj below this folder). Project files only add what's specific to them.
-->
<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- A local build is 0.0.0-dev; the release workflow passes the real one (-p:Version=N.M.0, docs/RELEASING.md). -->
        <VersionPrefix>0.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <!-- Only the Sdk is a NuGet package (build/SdkPackage.props turns it on for DevHub.Sdk and DevHub.Sdk.Core). -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
</Project>
